        "x-unit": "deg"
      },
      "drift_speed": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "description": "Speed of the buoy over the ground.",
        "x-bits": [
          105,
          112
        ],
        "x-unit": "m/s"
      },
      "latitude": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "description": "WGS 84, positive north.",
        "x-bits": [
          32,
          64
        ],
        "x-unit": "deg"
      },
      "longitude": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "description": "WGS 84, positive east.",
        "x-bits": [
          64,
          96
        ],
        "x-unit": "deg"
      },
      "message_id": {
        "anyOf": [
          {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "Identifies the message. See Table 5-1.",
        "x-bits": [
          0,
          8
        ],
        "x-unit": "1"
      },
      "message_length": {
        "anyOf": [
          {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "Length of the message in 16-bit words.",
        "x-bits": [
          8,
          16
        ],
        "x-unit": "words"
      },
      "satellites_in_view": {
        "anyOf": [
          {
            "maximum": 15,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "Satellites the receiver is tracking.",
        "x-bits": [
          112,
          116
        ],
        "x-unit": "1"
      },
      "sequence_number": {
        "anyOf": [
          {
            "maximum": 4095,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "Incremented by the buoy for each message; wraps from 4095 to 0.",
        "x-bits": [
          20,
          32
        ],
        "x-unit": "1"
      }
    },
    "title": "Position",
    "type": "object",
    "x-dictionary-version": "1.0.0"
  },
