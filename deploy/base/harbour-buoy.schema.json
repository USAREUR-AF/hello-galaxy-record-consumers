{
  "BUOY/Position": {
    "$id": "harbour-buoy/BUOY/Position",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Sent every minute, and at once when the mooring alarm is raised.",
    "properties": {
      "antenna_height": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
